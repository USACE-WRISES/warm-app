{
  "name": "warm-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WARM, the Web App for Riparian Models: a riparian model finder and nine model calculators, as a static web app on GitHub Pages.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
